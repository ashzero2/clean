#!/usr/bin/env bash
#
# benchmark — compare sweep against other disk-usage tools on one path.
#
#   ./benchmark [path] [--runs N] [--warmup N] [--tools a,b,c]
#
# Runs each available tool (sweep, du, dust, dua, ncdu, gdu) over the same
# directory, reports wall/CPU time, and cross-checks the reported total size
# against du. sweep is built from the working tree, so run it after a change.
#
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET="."
RUNS=5
WARMUP=1
ONLY=""

while [ $# -gt 0 ]; do
	case "$1" in
		--runs) RUNS="$2"; shift 2 ;;
		--warmup) WARMUP="$2"; shift 2 ;;
		--tools) ONLY="$2"; shift 2 ;;
		-h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
		-*) echo "unknown option: $1" >&2; exit 2 ;;
		*) TARGET="$1"; shift ;;
	esac
done

if [ ! -d "$TARGET" ]; then
	echo "benchmark: not a directory: $TARGET" >&2
	exit 1
fi
command -v python3 >/dev/null || { echo "benchmark: python3 is required" >&2; exit 1; }

WORK="$(mktemp -d "${TMPDIR:-/tmp}/sweep-bench.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT

echo "building sweep from $ROOT ..."
if ! ( cd "$ROOT" && go build -o "$WORK/sweep" ./cmd/sweep ); then
	echo "benchmark: go build failed" >&2
	exit 1
fi
SWEEP="$WORK/sweep"

want() { [ -z "$ONLY" ] || case ",$ONLY," in *",$1,"*) return 0 ;; *) return 1 ;; esac; }

NAMES=()
CMDS=()
add() { NAMES+=("$1"); CMDS+=("$2"); }

want sweep && add sweep "'$SWEEP' --no-tui ${SWEEP_ARGS:-} '$TARGET'"
command -v du   >/dev/null && want du   && add du   "du -sk '$TARGET'"
command -v dust >/dev/null && want dust && add dust "dust -d 1 '$TARGET'"
command -v dua  >/dev/null && want dua  && add dua  "dua aggregate '$TARGET'"
command -v ncdu >/dev/null && want ncdu && add ncdu "ncdu -o '$WORK/ncdu.json' '$TARGET'"
command -v gdu  >/dev/null && want gdu  && add gdu  "gdu -nq '$TARGET'"

if [ ${#NAMES[@]} -eq 0 ]; then
	echo "benchmark: no tools available" >&2
	exit 1
fi

echo "target: $TARGET"
echo "tools:  ${NAMES[*]}   (runs=$RUNS warmup=$WARMUP)"
echo

HF_ARGS=(--warmup "$WARMUP" --runs "$RUNS" --export-json "$WORK/hf.json" --style none --ignore-failure)
for i in "${!NAMES[@]}"; do
	HF_ARGS+=(-n "${NAMES[$i]}" "${CMDS[$i]}")
done

if command -v hyperfine >/dev/null; then
	hyperfine "${HF_ARGS[@]}" >/dev/null 2>&1
	if [ ! -s "$WORK/hf.json" ]; then
		echo "benchmark: hyperfine produced no results" >&2
		exit 1
	fi
else
	echo "benchmark: hyperfine not found; timing with python (wall only)" >&2
	NAMES_JOINED="$(printf '%s\n' "${NAMES[@]}")" CMDS_JOINED="$(printf '%s\n' "${CMDS[@]}")" \
		RUNS="$RUNS" WARMUP="$WARMUP" OUT="$WORK/hf.json" python3 - <<'PY'
import json, os, shlex, subprocess, sys, time

names = os.environ["NAMES_JOINED"].splitlines()
cmds = os.environ["CMDS_JOINED"].splitlines()
runs = int(os.environ["RUNS"])
warmup = int(os.environ["WARMUP"])
devnull = subprocess.DEVNULL

results = []
for name, cmd in zip(names, cmds):
    argv = shlex.split(cmd)
    for _ in range(warmup):
        subprocess.run(argv, stdout=devnull, stderr=devnull)
    times = []
    for _ in range(runs):
        start = time.perf_counter()
        subprocess.run(argv, stdout=devnull, stderr=devnull)
        times.append(time.perf_counter() - start)
    times.sort()
    results.append({
        "command": name,
        "mean": sum(times) / len(times),
        "min": times[0],
        "max": times[-1],
        "stddev": 0.0,
    })
json.dump({"results": results}, open(os.environ["OUT"], "w"))
PY
	if [ ! -s "$WORK/hf.json" ]; then
		echo "benchmark: timing produced no results" >&2
		exit 1
	fi
fi

# Reported sizes, gathered untimed, to confirm the tools agree.
du_bytes=""
if command -v du >/dev/null; then
	du_bytes=$(( $(du -sk "$TARGET" 2>/dev/null | awk '{print $1}') * 1024 ))
fi
sweep_bytes="$("$SWEEP" --json - "$TARGET" 2>/dev/null | awk -F: '/"allocated"/{gsub(/[ ,]/,"",$2); print $2; exit}')"

python3 - "$WORK/hf.json" "$du_bytes" "$sweep_bytes" <<'PY'
import json, sys

path, du_bytes, sweep_bytes = sys.argv[1], sys.argv[2], sys.argv[3]
results = json.load(open(path))["results"]


def metric(r, key, flat):
    s = r.get("summary")
    if s and s.get(key):
        return s[key]
    v = r.get(flat)
    return None if v is None else {"mean": v, "min": r.get("min"), "max": r.get("max")}


def f(m, k, suffix="s", dash="—"):
    v = None if m is None else m.get(k)
    return dash if v is None else f"{v:.3f}{suffix}"


rows = []
for r in results:
    rows.append((
        r.get("name") or r.get("command"),
        metric(r, "time_wall_clock", "mean"),
        metric(r, "time_user", "user"),
        metric(r, "time_system", "system"),
    ))
rows.sort(key=lambda x: (x[1] or {}).get("mean", 0))

name_w = max([len(x[0]) for x in rows] + [4])
print(f"{'tool':<{name_w}}  {'wall(mean)':>10}  {'±σ':>7}  {'min':>8}  {'max':>8}  {'user':>7}  {'sys':>7}")
print("-" * (name_w + 54))
for name, wall, user, sysm in rows:
    sd = f"{(wall or {}).get('stddev') or 0:.3f}s"
    print(f"{name:<{name_w}}  {f(wall,'mean'):>10}  {sd:>7}  {f(wall,'min'):>8}  {f(wall,'max'):>8}  {f(user,'mean'):>7}  {f(sysm,'mean'):>7}")

if du_bytes or sweep_bytes:
    print()
    print("reported size (allocated bytes, untimed)")
    if du_bytes:
        print(f"  {'du -sk':<8} {int(du_bytes):,}")
    if sweep_bytes:
        print(f"  {'sweep':<8} {int(sweep_bytes):,}")
    if du_bytes and sweep_bytes:
        diff = int(sweep_bytes) - int(du_bytes)
        print(f"  {'':<8} {'match' if diff == 0 else f'DIFF {diff:+,}'}")
PY
